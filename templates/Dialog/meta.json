{
    "name": "Dialog",
    "description": "A modal dialog component that overlays the primary window or another dialog, rendering content on top with an inert background.",
    "version": "1.0.0",
    "author": "@rajdeep0510",
    "created": "2025-01-12",
    "dependencies": {
        "npm": [],
        "peer": [
            "react",
            "react-dom"
        ]
    },
    "category": "overlay",
    "tags": [
        "dialog",
        "modal",
        "popup",
        "overlay",
        "tailwind"
    ],
    "props": {
        "theme": [
            "light",
            "dark"
        ],
        "variant": [
            "default",
            "glass",
            "minimal",
            "bordered"
        ],
        "size": [
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "full"
        ],
        "rounded": [
            "none",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "3xl"
        ],
        "position": [
            "center",
            "top",
            "bottom"
        ],
        "closeOnOverlayClick": "boolean",
        "closeOnEscape": "boolean",
        "showCloseButton": "boolean",
        "open": "boolean",
        "onOpenChange": "function"
    },
    "components": {
        "Dialog": {
            "description": "The root container for the dialog. Manages state and provides context to all child components.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Dialog sub-components (Trigger, Content, etc.)."
                },
                "theme": {
                    "type": "string",
                    "default": "dark",
                    "options": [
                        "light",
                        "dark"
                    ],
                    "description": "Color theme for the dialog."
                },
                "variant": {
                    "type": "string",
                    "default": "default",
                    "options": [
                        "default",
                        "glass",
                        "minimal",
                        "bordered"
                    ],
                    "description": "Visual style variant."
                },
                "size": {
                    "type": "string",
                    "default": "md",
                    "options": [
                        "sm",
                        "md",
                        "lg",
                        "xl",
                        "2xl",
                        "full"
                    ],
                    "description": "Maximum width of the dialog."
                },
                "rounded": {
                    "type": "string",
                    "default": "xl",
                    "options": [
                        "none",
                        "sm",
                        "md",
                        "lg",
                        "xl",
                        "2xl",
                        "3xl"
                    ],
                    "description": "Border radius of the dialog."
                },
                "position": {
                    "type": "string",
                    "default": "center",
                    "options": [
                        "center",
                        "top",
                        "bottom"
                    ],
                    "description": "Vertical position of the dialog."
                },
                "closeOnOverlayClick": {
                    "type": "boolean",
                    "default": true,
                    "description": "Close the dialog when clicking the overlay."
                },
                "closeOnEscape": {
                    "type": "boolean",
                    "default": true,
                    "description": "Close the dialog when pressing Escape key."
                },
                "showCloseButton": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the X close button in the top right corner."
                },
                "open": {
                    "type": "boolean",
                    "default": "undefined",
                    "description": "Controlled open state. If provided, the component becomes controlled."
                },
                "onOpenChange": {
                    "type": "function",
                    "default": "undefined",
                    "description": "Callback fired when the open state changes. Receives the new open value."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes for the root element."
                }
            }
        },
        "DialogTrigger": {
            "description": "Button or element that opens the dialog when clicked.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Content to render as the trigger."
                },
                "asChild": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, merges props onto the child element instead of wrapping in a button."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        },
        "DialogContent": {
            "description": "The modal content container. Renders a portal with overlay and dialog box.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Content to display inside the dialog."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes for the dialog box."
                }
            }
        },
        "DialogHeader": {
            "description": "Optional header container for title and description.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Header content (typically DialogTitle and DialogDescription)."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        },
        "DialogTitle": {
            "description": "The main title of the dialog.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Title text or content."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        },
        "DialogDescription": {
            "description": "A brief description below the title.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Description text or content."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        },
        "DialogBody": {
            "description": "Main content area of the dialog.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Body content."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        },
        "DialogFooter": {
            "description": "Footer area for action buttons.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Footer content (typically buttons)."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        },
        "DialogClose": {
            "description": "Button or element that closes the dialog when clicked.",
            "props": {
                "children": {
                    "type": "ReactNode",
                    "required": true,
                    "description": "Content to render as the close trigger."
                },
                "asChild": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, merges props onto the child element instead of wrapping in a button."
                },
                "className": {
                    "type": "string",
                    "default": "",
                    "description": "Additional CSS classes."
                }
            }
        }
    },
    "usage": {
        "basic": "<Dialog>\n  <Dialog.Trigger>Open Dialog</Dialog.Trigger>\n  <Dialog.Content>\n    <Dialog.Header>\n      <Dialog.Title>Dialog Title</Dialog.Title>\n      <Dialog.Description>This is a description.</Dialog.Description>\n    </Dialog.Header>\n    <Dialog.Body>Main content here</Dialog.Body>\n    <Dialog.Footer>\n      <Dialog.Close>Cancel</Dialog.Close>\n      <button>Confirm</button>\n    </Dialog.Footer>\n  </Dialog.Content>\n</Dialog>",
        "controlled": "const [open, setOpen] = useState(false);\n\n<Dialog open={open} onOpenChange={setOpen}>\n  <Dialog.Trigger>Open</Dialog.Trigger>\n  <Dialog.Content>\n    <Dialog.Title>Controlled Dialog</Dialog.Title>\n    <Dialog.Close>Close</Dialog.Close>\n  </Dialog.Content>\n</Dialog>"
    }
}